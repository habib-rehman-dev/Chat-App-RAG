# # Required database connection string
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database

# # Set to true only for local SQLite development
# USE_LOCAL_DB=false
# LOCAL_DATABASE_URL=sqlite+aiosqlite:///./local.db

# # Use one long random value. It must match Frontend AUTH_SECRET.
# AUTH_SECRET=replace-with-a-long-random-secret

# # LLM provider API key
# LLM_API_KEY=replace-with-your-llm-api-key

# # Optional application settings
# CORS_ORIGINS=["http://localhost:3000"]
# LLM_MODEL_NAME=qwen/qwen3.8-27b
# LLM_MODEL_TEMPERATURE=0.3
# CHROMA_PATH=./chroma_db
# CHROMA_COLLECTION=rag_documents
